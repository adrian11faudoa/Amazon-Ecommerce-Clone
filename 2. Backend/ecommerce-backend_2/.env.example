# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5432/marketplace?schema=public

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth / tokens
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=3600
RATE_LIMIT_EMAIL_VERIFICATION_MAX=5
RATE_LIMIT_EMAIL_VERIFICATION_WINDOW_SECONDS=3600
RATE_LIMIT_TOKEN_REFRESH_MAX=30
RATE_LIMIT_TOKEN_REFRESH_WINDOW_SECONDS=900

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=marketplace-backend

# ---------------------------------------------------------------------------
# Email provider
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@example.com

# ---------------------------------------------------------------------------
# Object storage (Volume 2 — media)
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
# Required when STORAGE_PROVIDER=s3:
# STORAGE_BUCKET=marketplace-media
# STORAGE_REGION=us-east-1
# Optional, for S3-compatible providers (e.g. MinIO, R2):
# STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
# AWS credentials are read from the standard AWS SDK credential chain
# (env vars / instance role / shared config) — never hardcoded here.
MEDIA_MAX_UPLOAD_BYTES=20000000
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,video/mp4
